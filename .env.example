# Configuration reference. .env is NOT loaded automatically.
# Set these as process environment variables before starting the service.
# Example in PowerShell: $env:EMOJI_COOKIE_SECURE = '0'
EMOJI_COOKIE_SECURE=0
EMOJI_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://localhost:18080,http://127.0.0.1:15173,http://localhost:15173
# Optional; defaults to the project's data/classroom.db.
# EMOJI_DATABASE_PATH=C:/your-project/data/classroom.db
# Use EMOJI_COOKIE_SECURE=1 only behind HTTPS in a deployment environment.
# AI service shares a local credential in data/ai-service.token by default.
# EMOJI_AI_TOKEN=use-the-same-random-secret-of-at-least-32-characters-in-both-services
EMOJI_AI_URL=http://127.0.0.1:18081
EMOJI_AI_MIN_CONFIDENCE=0.70
# Optional section 2.3 queue. Leave unset for the original synchronous mode.
# EMOJI_REDIS_URL=redis://127.0.0.1:6379/0
# File-based credentials override the default data/*.token fallback.
# EMOJI_AI_TOKEN_FILE=/run/secrets/ai_service
# EMOJI_AI_INGEST_TOKEN_FILE=/run/secrets/ai_ingest
# Docker Compose reads EMOJI_WEB_PORT; Python does not load this file itself.
# EMOJI_WEB_PORT=18090
# Local demo shortcuts and member management. OFF by default; loopback requests only.
EMOJI_DEMO_MODE=0
# Independent result ingestion uses a DIFFERENT credential, generated by prepare_ai.py.
# EMOJI_AI_INGEST_TOKEN=another-random-secret-of-at-least-32-characters
